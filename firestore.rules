rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) 
          && data.keys().size() <= 6
          && data.uid == userId
          && data.email is string && data.email.size() <= 256
          && data.role in ['admin', 'member']
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048));
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) 
        && isValidUser(incoming())
        && (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) || isAdmin());
    }

    // --- Projects ---
    match /projects/{projectId} {
      function userIsMember() {
        return isSignedIn() && (request.auth.uid in existing().members || existing().ownerId == request.auth.uid);
      }

      function isValidProject(data) {
        return data.keys().hasAll(['name', 'ownerId', 'members', 'createdAt'])
          && data.keys().size() <= 6
          && data.name is string && data.name.size() <= 100
          && data.ownerId is string && data.ownerId.size() <= 128
          && data.members is list && data.members.size() <= 100;
      }

      allow get: if userIsMember() || isAdmin();
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.members || isAdmin());
      allow create: if isEmailVerified() && isValidProject(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()))
        && isValidProject(incoming())
        && (incoming().ownerId == existing().ownerId);
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());

      // --- Tasks ---
      match /tasks/{taskId} {
        function isValidTask(data) {
          return data.keys().hasAll(['projectId', 'title', 'status', 'priority', 'createdAt', 'updatedAt'])
            && data.keys().size() <= 11
            && data.projectId == projectId
            && data.title is string && data.title.size() <= 200
            && data.status in ['todo', 'in-progress', 'in-review', 'done']
            && data.priority in ['low', 'medium', 'high']
            && (data.assigneeId == null || data.assigneeId is string)
            && (data.reviewerId == null || data.reviewerId is string)
            && (data.dueDate == null || data.dueDate is string);
        }

        allow read: if userIsMember() || isAdmin();
        allow create: if userIsMember() && isValidTask(incoming()) && incoming().updatedAt == request.time;
        allow update: if (userIsMember() || isAdmin()) 
          && isValidTask(incoming())
          && (
            // Anyone can update status
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            // Admins or owner can update anything
            (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin())
          )
          && incoming().updatedAt == request.time;
        allow delete: if (isSignedIn() && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin()));
      }
    }
  }
}
